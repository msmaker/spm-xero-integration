        <name>Xero sync error message</name>
        <order/>
        <script><![CDATA[function onLoad() {
    if (g_form.getValue('x_snc_spm_xero_i_0_synchronization_error') != 'true') {
        return;
    }
    var detail = g_form.getValue('x_snc_spm_xero_i_0_xero_sync_message');
    g_form.addErrorMessage(
        'Not sent to Xero, or sent only partially. ' +
        (detail ? 'Details: ' + detail + ' ' : '') +
        'Fix the cause, uncheck Synchronization Error and save to resend. Days already in Xero will be skipped.'
    );
}]]></script>
